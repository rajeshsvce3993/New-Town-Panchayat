{
  "expo": {
    "name": "Town Panchayat Management System",
    "slug": "town-panchayat-ems",
    "scheme": "tpems",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tn.townpanchayat.ems",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to capture inspection evidence and profile photos.",
        "NSLocationWhenInUseUsageDescription": "GPS is required to geotag field inspection works.",
        "NSPhotoLibraryUsageDescription": "Gallery access is used to choose a profile photo and save inspection photos.",
        "NSPhotoLibraryAddUsageDescription": "Inspection photos are saved to your photo gallery when you tap download.",
        "NSMicrophoneUsageDescription": "Microphone is unused; iOS may request it with camera.",
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.tn.townpanchayat.ems",
      "versionCode": 100,
      "adaptiveIcon": {
        "backgroundColor": "#1A3D66",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db4e8188-dc32-4377-bd98-330f8d5f1a0c"
      }
    },
    "autolinking": {
      "exclude": ["@expo/ui"]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#1A3D66",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "enablePngCrunchInReleaseBuilds": true,
            "gifEnabled": false,
            "useLegacyPackaging": true,
            "networkInspector": false,
            "buildArchs": ["arm64-v8a"],
            "extraProguardRules": "-keep class fr.greweb.reactnativeviewshot.** { *; }\n-keep class com.reactnativecommunity.webview.** { *; }\n",
            "packagingOptions": {
              "exclude": [
                "lib/x86/**",
                "lib/x86_64/**",
                "lib/armeabi-v7a/**"
              ]
            }
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GPS is required to geotag field inspection works."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gallery access is used to choose a profile photo.",
          "cameraPermission": "Camera is used to capture inspection evidence and profile photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Inspection photos are saved to your photo gallery when you tap download.",
          "savePhotosPermission": "Inspection photos are saved to your photo gallery when you tap download.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      "expo-document-picker",
      "expo-asset",
      "./plugins/withApkSize"
    ]
  }
}
