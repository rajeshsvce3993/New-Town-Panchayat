# =============================================================================
# Mobile app — copy to `mobile/.env`. Restart Expo after changes: npx expo start -c
# Match web: web uses APP_ENV, mobile uses EXPO_PUBLIC_APP_ENV (same local / prod idea).
# =============================================================================

# --- Environment (main switch) ---
# local = API http://localhost:3000 (physical device: 5-tap login logo → your PC LAN IP, or 10.0.2.2 on Android emulator)
# prod  = API https://townpanchayat.com (use for release APK / production build)
EXPO_PUBLIC_APP_ENV=local

# --- Google Maps (mobile) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
