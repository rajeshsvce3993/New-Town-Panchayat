# Optional edge cache for **safe, idempotent GET** APIs (read-only, user-agnostic).
# Include inside the `http { }` block of /etc/nginx/nginx.conf (zones + cache path).
#
#   proxy_cache_path /var/cache/nginx/tpms levels=1:2 keys_zone=tpms_api:64m
#       inactive=10m max_size=512m use_temp_path=off;
#
#   map $args $tpms_iw_counts_cache {
#       default 1;
#       ~*(?:^|&)countsOnly=1.*compactCounts=1 0;
#       ~*compactCounts=1.*countsOnly=1 0;
#   }
#
# Snippets below go inside your `server { }` for townpanchayat.com.

# Never cache auth, writes, or personalized portal state.
map $request_uri $tpms_nocache {
    default 0;
    ~^/api/auth/ 1;
    ~^/api/state 1;
    ~^/api/portal-state 1;
    ~^/api/jobs/ 1;
}

# Health — always fresh (or proxy to health sidecar on :5001)
location = /api/health {
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    add_header Cache-Control "no-store";
}

# Masters core — short TTL (geo + TP list stable for minutes)
location = /api/masters/core {
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_cache tpms_api;
    proxy_cache_valid 200 120s;
    proxy_cache_bypass $tpms_nocache;
    proxy_no_cache $tpms_nocache;
    add_header X-Cache-Status $upstream_cache_status;
}

# Dashboard stats — repeat views within 60s
location ~ ^/api/dashboard/stats {
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_cache tpms_api;
    proxy_cache_key "$scheme$request_method$host$request_uri";
    proxy_cache_valid 200 60s;
    proxy_cache_bypass $tpms_nocache;
    add_header X-Cache-Status $upstream_cache_status;
}

location /api/inspection-works {
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_cache tpms_api;
    proxy_cache_key "$scheme$request_method$host$request_uri$args";
    proxy_cache_valid 200 90s;
    proxy_cache_bypass $tpms_nocache;
    proxy_no_cache $tpms_iw_counts_cache;
    add_header X-Cache-Status $upstream_cache_status;
}

# Default API — no cache (see ops/nginx-townpanchayat-phase1.conf for rate limits)
location /api/ {
    proxy_pass http://127.0.0.1:5000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
}