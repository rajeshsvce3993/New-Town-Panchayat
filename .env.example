# Copy to `.env` and fill in real values. Never commit `.env`.

MONGODB_URI=mongodb://127.0.0.1:27018/dtp_enterprise
MONGODB_POOL_SIZE=100

S3_BUCKET_NAME=tms-2026
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_POOL_SIZE=500

GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Thin client: all auth + reads go to live portal (no local Mongo / data/db.json)
PORTAL_API_BASE=https://townpanchayat.com
USE_REMOTE_PORTAL_API=true
