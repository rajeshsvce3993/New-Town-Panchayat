# =============================================================================
# Web portal — copy this file to `.env` and fill in your values.
# Do not commit `.env` (it contains secrets).
# =============================================================================

# --- Environment (main switch) ---
# local = use http://localhost:PORT and MongoDB on this machine (daily development)
# prod  = use https://townpanchayat.com
#         • On production server: this app + MONGODB_URI on that server
#         • On your laptop with npm run dev: UI proxies to the live site API
APP_ENV=local

# On EC2 (townpanchayat.com host only): set CANONICAL_PROD_SERVER=1 so login uses local Mongo
# (avoids APP_ENV=prod + nginx loop calling https://townpanchayat.com → HTTP 503).

# Port for `npm run dev` / `node server.js` (local API is http://localhost:PORT)
PORT=3000

# --- Database (used when APP_ENV=local, or on server when APP_ENV=prod) ---
MONGODB_URI=mongodb://127.0.0.1:27017/dtp_enterprise
MONGODB_POOL_SIZE=100

# Production: live Mongo scope/geo (default on). Set LIVE_DATA_ONLY=0 to use user_scope_cache legacy path.
LIVE_DATA_ONLY=1

# Cutover (default ON when LIVE_DATA_ONLY=1):
# DISABLE_PORTAL_STATE=1     → GET /api/portal-state returns 410
# DISABLE_BOOTSTRAP_CACHE=1  → no portal_bootstrap_cache read/write
# SLIM_CORE_MASTERS=1        → /api/masters/core without full geo arrays
# MONGO_RESPONSE_CACHE=1     → dashboard stats shared across PM2 workers (Mongo TTL)

# Off-peak / deploy job: POST /api/jobs/production-refresh (header x-admin-key)
PRODUCTION_JOB_SECRET=

# Legacy only — leave unset so scope misses do not load the full JSON DB into memory.
# SCOPE_ALLOW_FULL_FALLBACK=1

# --- AWS S3 (photo / file uploads) ---
S3_BUCKET_NAME=townpanchayat
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_POOL_SIZE=500
# APK releases are S3-only (never saved under public/uploads on this PC).
# For APP_ENV=prod on localhost: use Webapp Settings S3 keys (same as production) or upload APK on https://townpanchayat.com

# --- Google Maps (web maps) ---
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
