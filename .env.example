# =============================================================================
# Web portal — copy this file to `.env` and fill in your values.
# Do not commit `.env` (it contains secrets).
# =============================================================================

# --- Environment (main switch) ---
# local = use http://localhost:PORT and MongoDB on this machine (daily development)
# prod  = use https://townpanchayat.com
#         • On production server: this app + MONGODB_URI on that server
#         • On your laptop with npm run dev: UI proxies to the live site API
APP_ENV=local

# Port for `npm run dev` / `node server.js` (local API is http://localhost:PORT)
PORT=3000

# --- Database (used when APP_ENV=local, or on server when APP_ENV=prod) ---
MONGODB_URI=mongodb://127.0.0.1:27017/dtp_enterprise
MONGODB_POOL_SIZE=100

# --- AWS S3 (photo / file uploads) ---
S3_BUCKET_NAME=tms-2026
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_POOL_SIZE=500

# --- Google Maps (web maps) ---
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
